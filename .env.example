# 이 파일 경로: FrontEnd/.env.example (프로젝트 루트, package.json과 같은 위치)
# 사용법: 이 파일을 같은 경로에 ".env.local" 이라는 이름으로 복사한 뒤, 아래 변수에 실제 값을 채워주세요.
#   예) FrontEnd/.env.local
# .env.local은 .gitignore(*.local)에 의해 git에 커밋되지 않습니다.

# 카카오 지도 JavaScript SDK 키 (카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키)
# 백엔드에서 사용하는 KAKAO_REST_API_KEY와는 다른 키입니다.
VITE_KAKAO_JAVASCRIPT_KEY=

# API 서버 주소 (선택). 비워두면 현재 origin의 "/api/..."로 호출합니다.
#   - 로컬 개발: vite.config.ts의 프록시가 "/api"를 떼고 localhost:8080으로 전달
#   - 배포: 백엔드 Nginx가 "/api"를 떼고 전달
# 값을 넣을 때는 "/api"를 붙이지 말고 Nginx 주소만 적습니다. (예: https://example.com)
VITE_API_BASE_URL=

# 채팅 API mock (선택, 개발 서버 전용). true로 두면 백엔드 없이 AI 검색 화면을 확인할 수 있습니다.
# 빌드(배포) 결과에는 영향이 없습니다. 값을 바꾸면 개발 서버를 다시 실행하세요.
# 로그인한 화면은 docs/RESEARCH_INTENT_WORK_SUMMARY.md의 "백엔드 없이 화면만 확인하기"를 참고하세요.
VITE_CHAT_MOCK=